# =============================================================================
# BTC Prediction Bot — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# --- Binance API ---
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# --- Polymarket ---
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_PRIVATE_KEY=your_polymarket_private_key_here
POLYMARKET_API_URL=https://clob.polymarket.com

# --- Deribit ---
DERIBIT_CLIENT_ID=your_deribit_client_id_here
DERIBIT_CLIENT_SECRET=your_deribit_client_secret_here

# --- Coinglass ---
COINGLASS_API_KEY=your_coinglass_api_key_here

# --- TimescaleDB ---
TIMESCALE_HOST=localhost
TIMESCALE_PORT=5432
TIMESCALE_DB=btc_prediction
TIMESCALE_USER=btcbot
TIMESCALE_PASSWORD=your_db_password_here

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Telegram Alerting ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# --- Trading Mode ---
PAPER_MODE=true
STARTING_CAPITAL=10.00

# --- Dashboard ---
DASHBOARD_API_PORT=8000
DASHBOARD_FRONTEND_PORT=3000
